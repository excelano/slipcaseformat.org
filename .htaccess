# Canonical host: redirect www to the bare domain so every page has one address.
# Without it the whole site answers at 200 on both, and the two split whatever
# a search engine has learned about a page between them.
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Serve the site's own 404 rather than the host's default page, which carries
# none of the navigation and looks like the domain is broken.
ErrorDocument 404 /404.html

# A profile's URI is its identity and resolves to its specification, which
# lives in excelano/slipcase-profiles.
RewriteRule ^profiles/records/?$ https://github.com/excelano/slipcase-profiles/blob/main/records/SPEC.md [R=302,L]
RewriteRule ^profiles/?$ https://github.com/excelano/slipcase-profiles [R=302,L]
